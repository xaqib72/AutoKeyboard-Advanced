{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoKeyboard Advanced",
  "mainBinaryName": "autokeyboard-advanced-v1.0.12",
  "version": "1.0.12",
  "identifier": "com.autokeyboard.advanced",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Untitled - AutoKeyboard Advanced",
        "width": 900,
        "height": 640,
        "minWidth": 660,
        "minHeight": 430,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../vision-worker/dist/autokeyboard-vision.exe": "vision/autokeyboard-vision.exe"
    },
    "targets": ["nsis", "msi"],
    "category": "Utility",
    "shortDescription": "Condition-aware keyboard and mouse automation",
    "longDescription": "A classic Windows macro editor with native input, variables, conditions, branching, loops, and optional image matching.",
    "windows": {
      "wix": { "language": "en-US" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
